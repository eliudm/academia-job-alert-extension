{
  "manifest_version": 3,
  "name": "Academia Job Alert",
  "version": "1.2",
  "description": "Instant alerts for new Academia.edu job postings — be first to claim within 60 seconds",
  "permissions": [
    "tabs",
    "alarms",
    "storage",
    "notifications",
    "scripting",
    "activeTab",
    "offscreen"
  ],
  "web_accessible_resources": [
    {
      "resources": ["offscreen.html", "sounds/alert.mp3"],
      "matches": ["<all_urls>"]
    }
  ],
  "host_permissions": [
    "https://writers.academia-research.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://writers.academia-research.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_badge_background_color": "#FF6B35"
  },
  "commands": {
    "quick-claim": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Instantly claim the job in the current alert"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
